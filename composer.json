{
  "name": "voku/do-epic-shit-demo",
  "type": "project",
  "description": "A refreshed Slim + Twig + RedBean demo for modern PHP runtimes.",
  "homepage": "https://github.com/voku/DO-EPIC-SHIT-Demo",
  "authors": [
    {
      "name": "Lars Moelleken",
      "email": "lars@moelleken.org"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-pdo_sqlite": "*",
    "ezyang/htmlpurifier": "^4.19",
    "gabordemooij/redbean": "^5.7",
    "slim/extras": "^2.0.3",
    "slim/slim": "^2.6.3",
    "slim/views": "^0.1.3",
    "twig/twig": "^1.44.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "MyApp\\": [
        "app/classes/"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit -c build/phpunit.xml"
  }
}
